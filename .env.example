# Token from @BotFather
BOT_TOKEN=123456:ABC...
# How often to check DEX Screener (seconds)
POLL_SECONDS=20

# X posts via twitterapi.io (see README)
TWITTERAPI_KEY=
X_POLL_SECONDS=120

# New deploys channel (see README): bot must be channel admin; set with /setdeploys @channel
DEPLOY_CHANNEL=
BETTEAR_REF=ref-1094156325
# Scan the last N days of blocks once to learn older dev deploys (0 = off; ~1 day ≈ 1 hour)
BACKFILL_DAYS=0
# Optional free FastNear API key (fastnear.com) — removes neardata rate limits for the deploys feed
FASTNEAR_API_KEY=
# Blocks downloaded in parallel by the deploys feed
DEPLOY_WORKERS=16
# New deploys source: intear (free push stream, default) or neardata (reads every block, heavy on FastNear)
DEPLOY_SOURCE=intear

# Memepad tokens always listed in /top and watched for MC/dip alerts (comma-separated)
PAD_EXTRA=
# How many recent nearly.trade tokens without a DexScreener pair /top checks via nearly.trade API
NEARLY_TOP_MAX=25
